# ─────────────────────────────────────────────────────────────────
#  Menuiserie Conan — Environment Variables
#  Copy this file to .env and fill in your Supabase credentials.
#
#  1. Go to https://supabase.com and create a new project.
#  2. Navigate to Settings > API.
#  3. Copy your Project URL and anon/public key below.
#  4. Run the SQL in supabase/schema.sql via the Supabase SQL editor.
#  5. Create an admin user via Authentication > Users > Invite User.
# ─────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
